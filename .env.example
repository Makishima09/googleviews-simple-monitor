# Environment variables for GoogleReviewsMonitor
# Copy this file to .env.local and fill in the values

# Google API Key (required for fetching reviews)
GOOGLE_API_KEY=your_google_api_key_here

# Cron Secret (minimum 32 characters, generate a secure random string)
# Example: openssl rand -base64 32
CRON_SECRET=your_secure_cron_secret_minimum_32_chars

# Admin Secret (for admin API protection - minimum 32 characters)
# Example: openssl rand -base64 32
ADMIN_SECRET=your_secure_admin_secret_minimum_32_chars

# Telegram Bot Token (for notifications - get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Default Telegram Chat ID (for notifications - your personal chat ID)
TELEGRAM_CHAT_ID=

# Optional: Alert webhook URL (Telegram, Slack, etc.)
ALERT_WEBHOOK_URL=

# Failure threshold - consecutive failed syncs before alerting (default: 3)
FAILURE_THRESHOLD=3

# Place IDs to monitor (comma-separated list)
# Example: ChIJxxx1,ChIJxxx2 (Replace with your actual Google Place IDs)
PLACE_IDS=

# Database path (optional, defaults to ./data/reviews.db)
DB_PATH=./data/reviews.db